<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<main class="main-content">
  <!-- ШАПКА ПРОФИЛЯ -->
  <div style="background:linear-gradient(135deg, rgba(22,27,34,0.9), rgba(13,17,23,0.95)), radial-gradient(circle at top right, rgba(34,197,94,0.15), transparent 60%); border:1px solid var(--border-color); border-radius:20px; padding:35px; margin-bottom:40px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:25px; box-shadow:0 8px 30px rgba(0,0,0,0.5);">
    
    <div style="display:flex; align-items:center; gap:20px;">
      <div style="width:75px; height:75px; background:linear-gradient(135deg, #16a34a, #22c55e); border:3px solid #4ade80; border-radius:18px; display:flex; align-items:center; justify-content:center; font-size:36px; box-shadow:var(--neon-green-glow);">
        👾
      </div>
      <div>
        <div style="display:flex; align-items:center; gap:10px;">
          <h1 style="font-size:1.8rem; font-weight:900; color:#fff;"><%= user.username %></h1>
          <% if (user.role === 'admin') { %>
            <span class="admin-badge" style="font-size:0.8rem; padding:3px 8px;">Администратор</span>
          <% } else { %>
            <span style="background:rgba(255,255,255,0.08); color:var(--text-muted); font-size:0.75rem; padding:3px 8px; border-radius:4px; font-weight:700;">Игрок</span>
          <% } %>
        </div>
        <p style="color:var(--text-dim); font-size:0.9rem; margin-top:4px;">
          ID игрока: #<%= user.id %> • Личный инвентарь
        </p>
      </div>
    </div>

    <!-- БАЛАНС И ПОПОЛНЕНИЕ ДЛЯ ТЕСТИРОВАНИЯ -->
    <div style="display:flex; align-items:center; gap:20px; background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:16px 24px;">
      <div>
        <div style="color:var(--text-dim); font-size:0.8rem; text-transform:uppercase; font-weight:700;">Текущий баланс:</div>
        <div style="font-size:1.8rem; font-weight:900; color:var(--neon-green);">
          <%= user.balance %> 🟢
        </div>
      </div>

      <!-- КНОПКА ТЕСТ-ПОПОЛНЕНИЯ -->
      <form action="/profile/topup" method="POST" style="margin:0;">
        <input type="hidden" name="amount" value="500">
        <button type="submit" class="btn btn-secondary btn-sm" title="Тестовое пополнение для проверки покупок">
          ➕ +500 монет
        </button>
      </form>
    </div>

  </div>

  <!-- РАЗДЕЛ: КУПЛЕННЫЕ СКИНИ -->
  <section style="margin-bottom: 50px;">
    <div class="section-header">
      <h2 class="section-title">
        <span>🎒</span> Мои скины (<%= purchasedSkins ? purchasedSkins.length : 0 %>)
      </h2>
      <a href="/skins" class="btn btn-primary btn-sm">
        + Купить новый скин
      </a>
    </div>

    <% if (purchasedSkins && purchasedSkins.length > 0) { %>
      <div class="skins-grid">
        <% purchasedSkins.forEach(skin => { %>
          <div class="skin-card">
            <div class="skin-card-badge owned">
              <%= skin.source === 'case' ? '🎁 Из кейса' : '🛒 Куплен' %>
            </div>

            <div class="skin-card-img-wrapper">
              <img src="<%= skin.image_url %>" alt="<%= skin.title %>" onerror="this.src='https://images.unsplash.com/photo-1550684848-fac1c5b4e853?w=600&auto=format&fit=crop&q=80'">
            </div>

            <div class="skin-card-body">
              <h3 class="skin-card-title"><%= skin.title %></h3>
              <p class="skin-card-desc"><%= skin.description || 'Скин готов к установке.' %></p>

              <div class="skin-card-footer" style="flex-direction:column; gap:10px; align-items:stretch;">
                <div style="display:flex; justify-content:space-between; font-size:0.8rem; color:var(--text-dim);">
                  <span>Получен:</span>
                  <span><%= new Date(skin.purchased_at).toLocaleDateString('ru-RU') %></span>
                </div>

                <a href="<%= skin.skin_file_url %>" download="<%= skin.title %>_skin.png" class="btn btn-primary btn-block">
                  📥 Скачать скин (.png)
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align:center; padding:50px 20px; background:var(--bg-card); border-radius:14px; border:1px solid rgba(255,255,255,0.08);">
        <div style="font-size:48px; margin-bottom:12px;">📦</div>
        <h3 style="margin-bottom:8px;">Ваш инвентарь пока пуст</h3>
        <p style="color:var(--text-muted); margin-bottom:20px;">
          У вас есть <strong style="color:var(--neon-green);"><%= user.balance %> 🟢</strong>! Выберите готовый скин в каталоге или испытайте удачу в кейсах.
        </p>
        <div style="display:flex; justify-content:center; gap:14px;">
          <a href="/skins" class="btn btn-primary">В каталог скинов</a>
          <a href="/cases" class="btn btn-purple">Открыть кейс</a>
        </div>
      </div>
    <% } %>
  </section>

  <!-- РАЗДЕЛ: ИСТОРИЯ ОПЕРАЦИЙ И КЕЙСОВ -->
  <section>
    <div class="section-header">
      <h2 class="section-title">
        <span>📜</span> История покупок и открытий
      </h2>
    </div>

    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Дата</th>
            <th>Событие</th>
            <th>Скин</th>
            <th>Списано</th>
            <th>Тип</th>
          </tr>
        </thead>
        <tbody>
          <% if (purchaseHistory && purchaseHistory.length > 0) { %>
            <% purchaseHistory.forEach(item => { %>
              <tr>
                <td style="color:var(--text-dim); font-size:0.85rem;">
                  <%= new Date(item.created_at).toLocaleString('ru-RU') %>
                </td>
                <td style="font-weight:700;">
                  <% if (item.source === 'case') { %>
                    <span style="color:#c084fc;">🎁 Дроп из кейса</span>
                  <% } else { %>
                    <span style="color:#4ade80;">🛒 Покупка в каталоге</span>
                  <% } %>
                </td>
                <td>
                  <div style="display:flex; align-items:center; gap:10px;">
                    <img src="<%= item.skin_image %>" alt="<%= item.skin_title %>" style="width:30px; height:30px; border-radius:6px; object-fit:cover;" onerror="this.src='https://images.unsplash.com/photo-1550684848-fac1c5b4e853?w=100&auto=format&fit=crop&q=80'">
                    <strong><%= item.skin_title %></strong>
                  </div>
                </td>
                <td style="font-weight:800; color:var(--text-main);">
                  <%= item.price_paid > 0 ? `-${item.price_paid} 🟢` : 'Кейс' %>
                </td>
                <td>
                  <span style="font-size:0.8rem; background:rgba(255,255,255,0.05); padding:3px 8px; border-radius:4px;">
                    <%= item.source %>
                  </span>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" style="text-align:center; color:var(--text-dim); padding:30px;">
                История транзакций пока отсутствует.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
