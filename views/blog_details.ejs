<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<main class="main-content">
  <div style="margin-bottom: 20px;">
    <a href="/blog" style="color:var(--text-muted); text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
      &larr; Вернуться ко всем статьям
    </a>
  </div>

  <div style="display:grid; grid-template-columns: 2fr 1fr; gap:35px; align-items:start;">
    
    <!-- СТАТЬЯ -->
    <article class="post-card" style="padding:35px;">
      <div class="post-meta">
        <span class="post-badge"><%= post.media_type.toUpperCase() %></span>
        <span>Автор: <strong style="color:#fff;"><%= post.author_name || 'Admin' %></strong></span>
        <span>• <%= new Date(post.created_at).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
      </div>

      <h1 style="font-size:2.2rem; font-weight:900; margin-bottom:20px; line-height:1.2; color:#fff;">
        <%= post.title %>
      </h1>

      <% if (post.media_url) { %>
        <div class="post-media-container" style="margin-bottom:25px;">
          <% if (post.media_type === 'image') { %>
            <img src="<%= post.media_url %>" alt="<%= post.title %>" class="post-media-img" onerror="this.src='https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=800&auto=format&fit=crop&q=80'">
          <% } else if (post.media_type === 'video') { %>
            <video controls class="post-media-video">
              <source src="<%= post.media_url %>" type="video/mp4">
              Ваш браузер не поддерживает встроенное видео.
            </video>
          <% } else if (post.media_type === 'file') { %>
            <div style="padding:20px;">
              <a href="<%= post.media_url %>" download class="post-file-download">
                <span>📄</span>
                <div>
                  <div style="font-weight:700;">Скачать прикрепленный файл</div>
                  <div style="font-size:0.8rem; color:var(--text-dim);"><%= post.media_url %></div>
                </div>
              </a>
            </div>
          <% } %>
        </div>
      <% } %>

      <div style="color:#c9d1d9; font-size:1.05rem; line-height:1.8; white-space:pre-line;">
        <%= post.content %>
      </div>

      <div style="margin-top:40px; padding-top:20px; border-top:1px solid rgba(255,255,255,0.08); display:flex; justify-content:space-between; align-items:center;">
        <a href="/blog" class="btn btn-secondary btn-sm">
          &larr; Все публикации
        </a>
        <span style="color:var(--text-dim); font-size:0.85rem;">
          SkinHub Blog • Minecraft
        </span>
      </div>
    </article>

    <!-- САЙДБАР: ДРУГИЕ СТАТЬИ -->
    <aside>
      <div style="background:var(--bg-card); border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:24px;">
        <h3 style="font-size:1.15rem; margin-bottom:18px; color:#fff; display:flex; align-items:center; gap:8px;">
          <span>📌</span> Другие статьи
        </h3>

        <% if (recentPosts && recentPosts.length > 0) { %>
          <div style="display:flex; flex-direction:column; gap:16px;">
            <% recentPosts.forEach(r => { %>
              <div style="border-bottom:1px solid rgba(255,255,255,0.05); padding-bottom:12px;">
                <a href="/blog/<%= r.id %>" style="color:#e6edf3; text-decoration:none; font-weight:600; font-size:0.9rem; line-height:1.4; display:block; margin-bottom:4px;">
                  <%= r.title %>
                </a>
                <span style="color:var(--text-dim); font-size:0.75rem;">
                  <%= new Date(r.created_at).toLocaleDateString('ru-RU') %>
                </span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p style="color:var(--text-dim); font-size:0.85rem;">Больше статей пока нет.</p>
        <% } %>
      </div>
    </aside>

  </div>
</main>

<%- include('partials/footer') %>
