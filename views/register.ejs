<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<main class="main-content">
  <div class="form-card">
    <div style="text-align:center; margin-bottom:25px;">
      <div style="width:50px; height:50px; background:linear-gradient(135deg, #a855f7, #7e22ce); border-radius:12px; display:inline-flex; align-items:center; justify-content:center; font-size:24px; margin-bottom:12px; box-shadow:var(--neon-purple-glow);">
        💎
      </div>
      <h1 style="font-size:1.8rem; font-weight:800; color:#fff;">Регистрация игрока</h1>
      <p style="color:var(--text-muted); font-size:0.9rem; margin-top:4px;">
        Создайте аккаунт и получите <strong style="color:#4ade80;">1000 изумрудов</strong> на баланс!
      </p>
    </div>

    <form action="/register" method="POST">
      <div class="form-group">
        <label for="username" class="form-label">Придумайте никнейм</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          class="form-control" 
          required 
          placeholder="Например, Alex_Craft"
          autocomplete="username"
        >
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Пароль</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          class="form-control" 
          required 
          placeholder="Придумайте пароль"
          autocomplete="new-password"
        >
      </div>

      <div class="form-group">
        <label for="confirmPassword" class="form-label">Повторите пароль</label>
        <input 
          type="password" 
          id="confirmPassword" 
          name="confirmPassword" 
          class="form-control" 
          required 
          placeholder="Повторите введенный пароль"
          autocomplete="new-password"
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:10px;">
        Создать аккаунт (+1000 🟢)
      </button>
    </form>

    <div style="text-align:center; margin-top:24px; font-size:0.9rem; color:var(--text-muted);">
      Уже есть профиль? 
      <a href="/login" style="color:var(--neon-blue); font-weight:700; text-decoration:none;">Войти в аккаунт</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
