<% if (alert) { %>
  <div class="alerts-container">
    <div class="alert-box alert-<%= alert.type === 'error' ? 'error' : (alert.type === 'info' ? 'info' : 'success') %>">
      <div>
        <% if (alert.type === 'error') { %>
          <span>⛔ </span>
        <% } else if (alert.type === 'info') { %>
          <span>ℹ️ </span>
        <% } else { %>
          <span>✅ </span>
        <% } %>
        <%= alert.message %>
      </div>
      <button type="button" onclick="this.parentElement.remove()" style="background:none; border:none; color:inherit; font-size:18px; cursor:pointer; padding-left:15px;">&times;</button>
    </div>
  </div>
<% } %>
